{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rp2: configure release",
      "type": "process",
      "command": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_MAKE_PROGRAM=${userHome}/.pico-sdk/ninja/v1.12.1/ninja"
      ],
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.31.5/bin/cmake.exe"
      }
    },
    {
      "label": "rp2: compile",
      "type": "process",
      "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
      "args": ["-C", "${workspaceFolder}/build"],
      "dependsOn": ["rp2: configure release"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
      }
    },
    {
      "label": "rp2: bootsel",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/bootsel.ps1"],
      "problemMatcher": [],
      "windows": {
        "command": "powershell.exe"
      }
    },
    {
      "label": "rp2: run",
      "type": "process",
      "command": "${env:HOME}/.pico-sdk/picotool/2.2.0/picotool/picotool",
      "args": ["load", "${command:raspberry-pi-pico.launchTargetPath}", "-fx"],
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0/picotool/picotool.exe"
      },
      "dependsOn": ["rp2: compile", "rp2: bootsel"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "rp2: flash",
      "type": "process",
      "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
      "args": [
        "-s",
        "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/${command:raspberry-pi-pico.getTarget}.cfg",
        "-c",
        "adapter speed 5000; program \"${command:raspberry-pi-pico.launchTargetPath}\" verify reset exit"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
      }
    },
    {
      "label": "host: configure release",
      "type": "process",
      "command": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build_host",
        "-G", "Ninja",
        "-DPICO_PLATFORM=host",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_MAKE_PROGRAM=${userHome}/.pico-sdk/ninja/v1.12.1/ninja"
      ],
      "options": {
        "env": {
          "Path": "C:\\msys64\\usr\\bin;C:\\msys64\\mingw64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.31.5/bin/cmake.exe"
      }
    },
    {
      "label": "host: compile",
      "type": "process",
      "group": "build",
      "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
      "args": ["-C", "${workspaceFolder}/build_host"],
      "options": {
        "env": {
          "Path": "C:\\msys64\\usr\\bin;C:\\msys64\\mingw64\\bin;${env:PATH}"
        }
      },
      "dependsOn": ["host: configure release"],
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "windows": {
        "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
      }
    },
    {
      "label": "host: run",
      "type": "process",
      "command": "${workspaceFolder}/build_host/prism",
      "args": [],
      "group": "build",
      "problemMatcher": "$gcc",
      "dependsOn": ["host: compile"],
      "windows": {
        "command": "${workspaceFolder}/build_host/prism.exe"
      }
    }
  ]
}
